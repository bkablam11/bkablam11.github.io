  <section id="portfolio">
    <div class="container">
      <div class="section-title">
        <h2 id="portfolio-heading">Portfolio de Projets</h2>
        <p>Une sélection des projets les plus significatifs développés sur GitHub et en environnement réel.</p>
      </div>

      <!-- Filters -->
      <ul class="portfolio-filters" id="portfolio-filters">
        <li data-filter="*" class="filter-active">Tous les projets</li>
        <li data-filter=".filter-ia">IA &amp; Vision</li>
        <li data-filter=".filter-web">Web &amp; App</li>
        <li data-filter=".filter-data">Data &amp; ML</li>
      </ul>

      <div class="row g-4 portfolio-container">
        <div class="col-md-6 col-lg-4 portfolio-item filter-data">
          <div class="portfolio-card" id="project-card-1">
            <div class="portfolio-img-wrapper">
              <img src="assets/img/me/poisson.png" class="portfolio-img" alt="poissonnerie_pro_app" loading="lazy">
            </div>
            <div class="portfolio-body">
              <h4>poissonnerie_pro_app</h4>
              <p>Application de gestion commerciale pour une poissonnerie avec ERP, réduisant le temps de traitement des commandes de 40% et gérant un stock de 5000+ références. Stack: Django REST + PostgreSQL + Docker + CI/CD GitHub Actions.</p>
              <div class="portfolio-tags">
                <span class="portfolio-tag">Python</span>
                <span class="portfolio-tag">Django</span>
